# Lineage 2 Linux Engineering Project - Git Ignore

# Binary clients and heavy assets
clients/*
!clients/.gitkeep

# Isolated Wine/Proton prefixes
prefixes/*
!prefixes/.gitkeep

# Download archives and media
downloads/*
!downloads/.gitkeep

# Extracted Wine/Proton runners
tools/runners/*
!tools/runners/.gitkeep
tools/winetricks

# Archive formats
*.zip
*.7z
*.rar
*.tar.gz
*.tar.xz
*.iso

# Logs and runtime artifacts
*.log
*.tmp
*.bak
*~

# Wine runtime files
*.wineserver
__pycache__/
*.pyc

# Local credentials and environment (STRICTLY NON-COMMITTED)
.env
.env.*
!.env.example
*.local
*.local.json
config/*.local.json
config/credentials.json


# Standalone cross-platform launcher repository
l2sudamerica-launcher/

# External runtime tools, caches, and compiled shims
tools/mangohud/
tools/vkbasalt/
tools/dxvk_cache/
tools/dxvk_32/
tools/patches/
tools/shims/*.so
